# Copy to: ~/.config/universal-dragon/nova-bridge.env
# Existing ~/.dragon-voice.env may provide GROQ_API_KEY and DRAGON_VOICE_TOKEN.

NOVA_BRIDGE_HOST=127.0.0.1
NOVA_BRIDGE_PORT=8130
NOVA_ALLOWED_ORIGINS=https://voice.universaldragon.com,https://project28268.websitepublisher.ai
# Secure default. Use 0 only in the local, non-public staging config.
NOVA_REQUIRE_CF_ACCESS=1
NOVA_BRIDGE_TOKEN=

NOVA_VOICE_URL=http://127.0.0.1:8125
NOVA_V2_VOICE_URL=http://127.0.0.1:8124
NOVA_V2_VOICE_PROFILE=nova_warm
NOVA_EDGE_TTS_ENABLED=1
NOVA_EDGE_TAMIL_VOICE=ta-IN-PallaviNeural
NOVA_EDGE_ENGLISH_VOICE=en-IN-NeerjaExpressiveNeural
NOVA_EDGE_RATE=+4%

# Brain API keys are inherited from ~/.dragon-voice.env when already configured.
# Optional NOVA_VOICE_TOKEN / NOVA_V2_VOICE_TOKEN can be added here only if different.
GROQ_MODEL=openai/gpt-oss-120b
NOVA_BRAIN_TIMEOUT=45
NOVA_VOICE_TIMEOUT=20
NOVA_BRIDGE_MAX_TEXT=2000
NOVA_BRIDGE_HISTORY=12
NOVA_BRIDGE_RATE=30
NOVA_AUDIO_TTL=300
