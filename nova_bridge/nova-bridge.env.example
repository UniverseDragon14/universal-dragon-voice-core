# Copy to: ~/.config/universal-dragon/nova-bridge.env
# Never commit real secrets.

NOVA_BRIDGE_HOST=127.0.0.1
NOVA_BRIDGE_PORT=8130
NOVA_ALLOWED_ORIGINS=https://voice.universaldragon.com,https://project28268.websitepublisher.ai
NOVA_REQUIRE_CF_ACCESS=1

# Optional for trusted non-browser clients only. Never expose this in website JS.
NOVA_BRIDGE_TOKEN=CHANGE_ME_LONG_RANDOM_VALUE

NOVA_VOICE_URL=http://127.0.0.1:8125
NOVA_VOICE_TOKEN=CHANGE_ME_SAME_PRIVATE_VOICE_TOKEN

# Configure at least one brain provider.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
MOONSHOT_API_KEY=
MOONSHOT_MODEL=kimi-k2-0905-preview
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

NOVA_BRAIN_TIMEOUT=45
NOVA_VOICE_TIMEOUT=90
NOVA_BRIDGE_MAX_TEXT=2000
NOVA_BRIDGE_HISTORY=12
NOVA_BRIDGE_RATE=30
NOVA_AUDIO_TTL=300
